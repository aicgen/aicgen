{
  "alwaysThinkingEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(.env*)",
            "command": "echo 'Blocked: Sensitive file access not allowed' >&2; exit 2"
          },
          {
            "type": "command",
            "if": "Read(secrets/**)",
            "command": "echo 'Blocked: Secrets directory is protected' >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(.env*)",
            "command": "echo 'Blocked: Cannot modify environment files' >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.env*)",
            "command": "echo 'Blocked: Cannot modify environment files' >&2; exit 2"
          }
        ]
      }
    ]
  },
  "aicgen": {
    "profileLevel": "full",
    "safety": [
      "Generated hooks are limited to local deterministic checks.",
      "Generated hooks do not run test suites; use /check for validation.",
      "Review hook commands before enabling additional side-effecting automation.",
      "MCP and plugin setup scripts are not generated without explicit opt-in."
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(bun *)",
      "Bash(git *)",
      "Bash(npx *)",
      "Read(src/**)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(CLAUDE.md)",
      "Read(.claude/**)",
      "Write(src/**)",
      "Write(.claude/**)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env*)",
      "Read(secrets/**)",
      "Bash(rm *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Write(package.json)",
      "Write(.gitignore)",
      "Write(.env.example)"
    ]
  }
}
